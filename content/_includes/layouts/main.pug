doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1.0')
    meta(name='theme-color' content='#212529')
    title=title
    if description
      meta(name='description', content=description)
    link(rel='icon' type='image/svg+xml' href='/images/vermont.svg')
    link(rel='stylesheet', href='/styles/main.css')

  body
    //- Named so it stays distinct from the breadcrumb nav on the topic pages.
    nav#header.navbar.navbar-expand-md.navbar-dark.bg-dark(aria-label='Main')
      .container.p-2
        a.navbar-brand.d-flex.align-items-center(href='/')
          img.me-2(src='/images/vermont.svg' alt='' height='32')
          | Vermont Football Officials
        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#mainNav' aria-controls='mainNav' aria-label='Toggle main navigation' aria-expanded='false')
          span.navbar-toggler-icon
        #mainNav.navbar-collapse.collapse
          .navbar-nav.ms-auto
            a.nav-item.nav-link.text-white.p-2(href='/information/') Information
            a.nav-item.nav-link.text-white.p-2(href='/quizzes/') Quizzes
            a.nav-item.nav-link.text-white.p-2(href='/draw/') Play Draw
            a.nav-item.nav-link.text-white.p-2(href='/contact/') Contact Us
    main#content.container.my-4.p-4.bg-white.rounded.shadow-sm
      | !{content}

    //- The card treatment matches #content so the footer reads as part of the
    //- page and not as a stripe of background.
    footer#footer.container.mb-4.p-4.bg-white.rounded.shadow-sm
      .row.gy-3.align-items-center
        .col-md
          p.mb-0 Vermont Football Officials
        .col-md-auto.text-md-end
          button.btn.btn-outline-secondary.btn-sm#sign-in(type='button') Sign in

    script(src='/js/bootstrap.bundle.min.js')
    //- Editing. A reader's browser answers two storage lookups here and loads
    //- nothing. An author's — signed in with Netlify Identity, handed a token
    //- by /admin/, or opening a page with ?cms-edit — loads the ContentTools
    //- in-page editor (static/cms/boot.js).
    //-
    //- The emails Netlify Identity sends (invites, password resets, email
    //- confirmations) link to the site root with a token in the fragment, and
    //- only the Identity widget knows what to do with one, so those load it.
    script(type='module').
      const stored = (storage, key) => {
        try {
          return storage.getItem(key) !== null;
        } catch {
          return false;
        }
      };
      const identityUser = stored(localStorage, 'gotrue.user');
      const signedIn = identityUser || stored(sessionStorage, 'content-tools:github-token');

      // The footer's button opens the Netlify Identity widget, fetched on the
      // first click so a reader never downloads it. Signing in or out reloads
      // the page, so the editor loads (or stops loading) to match.
      const button = document.getElementById('sign-in');
      if (identityUser) button.textContent = 'Account';
      let widget;
      button.addEventListener('click', async () => {
        widget ??= new Promise((resolve, reject) => {
          if (window.netlifyIdentity) return resolve(window.netlifyIdentity);
          document.head.append(Object.assign(document.createElement('script'), {
            src: '/js/netlify-identity-widget.js',
            onload: () => resolve(window.netlifyIdentity),
            onerror: reject,
          }));
        }).then((identity) => {
          identity.on('login', () => location.reload());
          identity.on('logout', () => location.reload());
          return identity;
        });
        (await widget).open();
      });

      if (signedIn || new URLSearchParams(location.search).has('cms-edit') || location.hash.includes('cms-token=')) {
        import('/cms/boot.js');
      } else if (/(confirmation|invite|recovery|email_change)_token=/.test(location.hash)) {
        document.head.append(Object.assign(document.createElement('script'), { src: '/js/netlify-identity-widget.js' }));
      }

h1 Sign In
p.lead
  button.btn.btn-dark#open-sign-in(type='button') Sign in

p
  | Once you're signed in, open any article or quiz and press the pencil at
  | the top left of the page to edit it in place, or go to
  |
  a(href='/admin/') the editor
  |  to see everything you can edit and your changes waiting for review.

noscript
  p Signing in needs JavaScript enabled.

script(src='/js/netlify-identity-widget.js')
script.
  if (window.netlifyIdentity) {
    document.getElementById('open-sign-in').addEventListener('click', function () {
      netlifyIdentity.open('login');
    });
  }
